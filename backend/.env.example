# BuyWise Backend Environment Variables
# Copy this file to .env and fill in your values

# For local development without PostgreSQL, leave DATABASE_URL unset (SQLite fallback)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/buywise
DATABASE_URL=sqlite:///./buywise.db
SECRET_KEY=change-me-in-production-secret-key
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]
API_V1_STR=/api
PROJECT_NAME=BuyWise
VERSION=1.0.0
WORKFLOW_TIMEOUT_SECONDS=300
MAX_NEGOTIATION_ROUNDS=3